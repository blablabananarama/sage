  (footprint "bayleaf:Kailh_PG1316S_castellated" (layer "F.Cu")
    (tstamp 98be388c-c391-485a-b54b-340caca0a790)
    (at 54.75 46.15)
    (descr "Kailh PG1316S (CPG1316S01D02) for hand soldering: the two switch contacts sit on plated half-holes at the front edge of a window in the board, and the four frame-anchor pads (2 x 2 mm on top) each have a 0.7 mm plated hole with a 1.4 mm pad on the bottom, so the whole switch can be soldered from below with an iron (or the anchors reflowed on a hotplate as usual). Window/half-hole idea after Mike Holscher's mikecinq; drawn independently from the Kailh land pattern. Order with castellated holes.")
    (tags "kailh pg1316s keyboard switch castellated hand solder")
    (attr through_hole)
    (fp_text reference "SW17" (at 0 -4.6) (layer "F.Fab") hide
